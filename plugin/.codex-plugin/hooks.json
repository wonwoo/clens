{
  "description": "Right after Codex compacts a conversation, put that session's clens work record back into it.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/compact.mjs\"",
            "timeout": 30,
            "additionalContextLimit": 10000
          }
        ]
      }
    ]
  }
}
