{
  "name": "@clens/cli",
  "version": "0.2.2",
  "description": "Search past Claude Code and Codex sessions — local SQLite index served over MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonwoo/clens.git"
  },
  "homepage": "https://github.com/wonwoo/clens#readme",
  "bugs": {
    "url": "https://github.com/wonwoo/clens/issues"
  },
  "bin": {
    "clens": "plugin/dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "plugin/dist"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "redact": "tsx test/scripts/redact.ts",
    "synth": "tsx test/scripts/synth-corpus.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.5.0",
    "kiwi-nlp": "^0.23.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
